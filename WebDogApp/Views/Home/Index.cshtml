@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4 fw-bold text-primary">
            Национална изложба на
            кучета
        </h1>
        <div class="my-4">
            <img src="https://t3.ftcdn.net/jpg/18/55/52/44/360_F_1855524482_b4o5zNNJbM1RhEplL5J0W8Cnb
sRoOjsr.jpg"
                 class="img-fluid rounded shadow"
                 alt="Кучета от различни породи"
                 style="max-width: 100%; height: auto;">

        </div>
    </div>
    <div class="row justify-content-center mt-5">
        <div class="col-md-8 text-center">
            <h2 class="mb-4">Какво ви очаква на събитието?</h2>
            <ul class="list-unstyled lh-lg fs-5">
                <li><strong>Конкурси за различни породи</strong> </li>
                <li><strong>Специални награди</strong> </li>
                <li> <strong>Аксесоари за кучета</strong> </li>
            </ul>
            <p class="mt-4 text-muted">
                Заповядайте, за да споделим заедно
                любовта към четириногите ни приятели!
            </p>
        </div>
    </div>
</div>
